# teddy-share-app 用到的環境變數（只列名字，值不要放進 repo）
# Vercel：Settings → Environment Variables（Production＋Preview 都設）
# 本機：程式不讀 .env 檔，請在 shell 先設好（PowerShell：$env:NAME='...'）

# 必要
GITHUB_TOKEN=                # 推客戶頁到 sky811117/teddy-shares（Contents 寫權限）
GOOGLE_MAPS_EMBED_KEY=       # Google Maps Embed API 金鑰（客戶頁路段小地圖；沒設整支啟動不了）

# 選填
SHARE_PUBLISH_KEY=           # 覆蓋／重建既有客戶頁的通關碼（X-Share-Key），沒設一律擋覆蓋
SHARE_KEY_ENFORCE=           # 1＝新建頁也要帶通關碼；預設 0 只記 log
NOTION_TOKEN=                # 客戶頁瀏覽紀錄寫進 Notion
NOTION_DB_ID=
TELEGRAM_BOT_TOKEN=          # 推 TG 通知
TELEGRAM_CHAT_ID=
